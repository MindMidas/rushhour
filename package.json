    "tailwindcss": "^4.3.0",
    "vite": "8.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.32.0"
  }
}
